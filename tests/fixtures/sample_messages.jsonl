{"msg_id": "m0067", "timestamp": "2026-10-31T19:41:36.836504", "sender": {"wechat_id": "wx_lhua", "nickname": "李华"}, "type": "text", "content": "C5 的 shipcheck 体检要达到多少分才算过？", "media_ref": null, "reply_to": null, "_label": "question", "_gold_refs": ["C5"]}
